    "version": "0.2.0",
    "configurations": [
        {
            "name": "Inventory Count",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "Inventory Count (Disable Sync)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "DISABLE_SYNC=true"
            ]
        },
        {
            "name": "Companion",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "COMPANION=true"
            ]
        },
    ]
